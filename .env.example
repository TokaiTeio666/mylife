# ---------------------------------------------------------------------------
# mylife 环境变量示例（复制为 .env 后修改）
# 说明：密钥类变量不得提交；生产环境务必更换全部默认值。
# ---------------------------------------------------------------------------

# 运行环境：development | test | production
MYLIFE_ENV=development
MYLIFE_LOG_LEVEL=INFO
# 是否记录未处理异常的完整堆栈（可能含 SQL 参数）。生产保持 false。
MYLIFE_LOG_EXCEPTIONS=false

# 对外访问地址（Caddy / Next.js）
MYLIFE_DOMAIN=localhost
MYLIFE_PUBLIC_BASE_URL=http://localhost:8000
MYLIFE_WEB_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=mylife
POSTGRES_USER=mylife_migrator
POSTGRES_PASSWORD=change-me-migrator
MYLIFE_DB_HOST=postgres
# 容器内固定 5432；在宿主直接运行 API/测试时改为 dev override 的映射端口（25432）。
MYLIFE_DB_PORT=5432
MYLIFE_APP_DB_USER=mylife_app
MYLIFE_APP_DB_PASSWORD=change-me-app
MYLIFE_SYSTEM_DB_USER=mylife_system
MYLIFE_SYSTEM_DB_PASSWORD=change-me-system
MYLIFE_DB_NAME=mylife

# Redis
MYLIFE_REDIS_URL=redis://redis:6379/0
# 宿主直接运行 API/测试时使用 dev override 的映射端口：redis://localhost:26379/0

# MinIO（Phase 1 起使用）
MYLIFE_S3_ENDPOINT=http://minio:9000
MYLIFE_S3_ACCESS_KEY=change-me-minio
MYLIFE_S3_SECRET_KEY=change-me-minio-secret
MYLIFE_S3_BUCKET=mylife

# 会话与加密
# 32 字节 base64url 随机串；生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
MYLIFE_SECRET_KEY=dev-only-change-me-please-32-bytes-min
# 登录 Cookie 是否加 Secure。生产必须 true；仅本地 http://localhost 调试设为 false。
MYLIFE_COOKIE_SECURE=true
MYLIFE_SESSION_TTL_DAYS=30
MYLIFE_SESSION_IDLE_DAYS=7

# 限流：fail-open 读、fail-closed 写
MYLIFE_RATE_LIMIT_BACKEND=redis

# 任务队列（redis=Celery；off=不投递，仅测试/单机调试）
MYLIFE_QUEUE_BACKEND=redis

# 构建镜像时使用的 PyPI 源（默认官方；网络受限时可改为可达镜像）
MYLIFE_PYPI_INDEX=https://pypi.org/simple

# 数据根（ZIP 原件 / 快照 / 导出；容器内固定挂载）
MYLIFE_DATA_ROOT=/srv/mylife/data

# Embedding（Phase 1 默认 mock；生产改为 openai 兼容 + BGE-M3）
MYLIFE_EMBEDDING_PROVIDER=mock
MYLIFE_EMBEDDING_BASE_URL=
MYLIFE_EMBEDDING_API_KEY=
MYLIFE_EMBEDDING_MODEL=BAAI/bge-m3
MYLIFE_EMBEDDING_DIMENSION=1024

# Chat LLM（mock 用于测试/离线；生产填 OpenAI/DeepSeek 兼容接口）
MYLIFE_LLM_PROVIDER=mock
MYLIFE_LLM_BASE_URL=
MYLIFE_LLM_API_KEY=
MYLIFE_LLM_MODEL=deepseek-chat

# 交付与调度（Phase 4）
# 仅测试本地裸仓库时设为 true；生产必须 false（SEC-12）。
MYLIFE_ALLOW_LOCAL_GIT=false
# dispatcher 单副本 tick 间隔与 API 内租约 sweeper。
MYLIFE_DISPATCHER_ENABLED=true
MYLIFE_DISPATCHER_INTERVAL_SECONDS=60
MYLIFE_REVIEW_SWEEPER=true
MYLIFE_REVIEW_SWEEPER_INTERVAL_SECONDS=15
# 删除冷却天数（SEC-27）。
MYLIFE_DELETION_COOLDOWN_DAYS=30

# 导出、蓝绿换维与备份（Phase 5）
MYLIFE_EXPORT_TTL_DAYS=7
MYLIFE_EXPORT_DAILY_LIMIT=3
MYLIFE_EMBEDDING_COVERAGE_THRESHOLD=0.995
MYLIFE_EMBEDDING_RETIRE_DAYS=7
# 允许用 http:// 连接的私有模型主机（逗号分隔，默认空即强制 https://）
MYLIFE_ALLOWED_PRIVATE_PROVIDER_HOSTS=
MYLIFE_BACKUP_DIR=./data/backups
# 设置后 backup_pg.sh / backup_data.sh 自动使用 age 或 openssl 加密（SEC-28）
MYLIFE_BACKUP_PASSPHRASE=

# Caddy
MYLIFE_TLS_MODE=internal
